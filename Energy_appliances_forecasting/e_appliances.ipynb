      "source": [
        "#import crossvalidaion class from prophet\n",
        "from prophet.diagnostics import cross_validation, performance_metrics\n",
        "\n",
        "model1 = Prophet(yearly_seasonality=False,\n",
        "                 weekly_seasonality=True,\n",
        "                 daily_seasonality=True,\n",
        "                 seasonality_prior_scale=1.0,\n",
        "                 changepoint_prior_scale=30)\n",
        "\n",
        "#model1.add_country_holidays()\n",
        "\n",
        "model1.fit(data)\n",
        "\n",
        "df_cv = cross_validation(\n",
        "    model=model1,\n",
        "    initial='90 days', # period to train\n",
        "    period=15, #cutoff every 15days\n",
        "    horizon='30 days' #period to predict\n",
        ")\n",
        "\n",
        "\n",
        "# compute perfomance metrics\n",
        "df_perf = performance_metrics(df_cv)\n",
        "df_perf"
      ]
    },
