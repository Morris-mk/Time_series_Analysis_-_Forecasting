      "source": [
        "# rename colums\n",
        "data.columns = ['ds', 'y']\n",
        "\n",
        "#initialize and fit model class\n",
        "model = Prophet()\n",
        "model.fit(data)\n",
        "\n",
        "# create future dates\n",
        "future_dates = model.make_future_dataframe(periods=150,\n",
        "                                           freq='d',\n",
        "                                           include_history=True\n",
        "                                           )\n",
        "\n",
        "\n",
        "# predict\n",
        "preds = model.predict(future_dates)\n",
        "preds.head()"
      ]
    },
